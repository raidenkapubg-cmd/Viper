# ============================================================================
#  VIPER configuration. Copy to .env and fill in. Real environment variables
#  always override this file (handy for systemd EnvironmentFile / CI secrets).
# ============================================================================

# ---- Server ----------------------------------------------------------------
VIPER_ENV=staging                 # staging | production (label only)
VIPER_HOST=127.0.0.1              # keep on loopback behind nginx on the VPS
VIPER_PORT=8710
# Public URL the browser uses. FYERS redirects here after login, so each app's
# Redirect URI in the FYERS dashboard must be  <VIPER_PUBLIC_BASE_URL>/api/auth/callback
VIPER_PUBLIC_BASE_URL=http://127.0.0.1:8710
VIPER_DATA_DIR=./data             # SQLite DB, SDK logs (relative = project root)
VIPER_LOG_LEVEL=INFO
# Terminal login. STRONGLY recommended on any internet-facing host: this UI can place real orders.
VIPER_UI_PASSWORD=
VIPER_SESSION_SECRET=             # long random string; `python -c "import secrets;print(secrets.token_hex(32))"`

# ---- FYERS apps -------------------------------------------------------------
# Trading API app: orders, positions, funds, order socket. Whitelisted on IP_A.
FYERS_TRADING_APP_ID=             # e.g. XXXXXXXXXX-100
FYERS_TRADING_SECRET=
# FYERS_TRADING_REDIRECT_URI=     # default: <VIPER_PUBLIC_BASE_URL>/api/auth/callback

# Non-Trading / Data API app (or second account): quotes, history, option chain, data socket. Whitelisted on IP_B.
FYERS_DATA_APP_ID=
FYERS_DATA_SECRET=
# FYERS_DATA_REDIRECT_URI=

# With only ONE app configured, market data reuses the trading token (and leaves from IP_A).
# DATA_USES_TRADING_TOKEN=true

# ---- Dual-IP source binding -------------------------------------------------
# false on laptops/staging (OS picks the route). true on the VPS.
ENABLE_IP_BINDING=false
VPS_TRADING_SOURCE_IP=            # IP_A: whitelisted on the Trading app
VPS_DATA_SOURCE_IP=               # IP_B: whitelisted on the Data app
# Startup refuses to call FYERS if binding is enabled and either IP is not assigned
# to this host (run deploy/check_ips.sh to verify both egress correctly).

# ---- Market feed ------------------------------------------------------------
# auto      = live FYERS feed when a data token exists, otherwise the synthetic staging feed
# live      = live only (feed stays offline until you authenticate)
# synthetic = always synthetic (UI shows SYNTHETIC FEED; live orders are hard-blocked)
FEED_MODE=auto
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
MARKET_TZ=Asia/Kolkata

# ---- Live execution safety ----------------------------------------------------
# Master switch. Until true, ON/AUTO instruments trade in Shadow only and the
# Positions page shows "LIVE_TRADING_ENABLED=false" as a blocker.
LIVE_TRADING_ENABLED=false

# ---- REST pacing (never rejects; only smooths bursts) -----------------------
FYERS_REST_RATE_PER_SEC=8
FYERS_REST_BURST=10
FYERS_REST_MAX_RETRIES=5          # retries happen ONLY on real HTTP 429 from FYERS
FYERS_QUOTE_CACHE_MS=750

# ---- Shadow / learning --------------------------------------------------------
SHADOW_START_CAPITAL=500000
LEARNING_WINDOW_DAYS=28

# ---- Lot sizes (fallbacks; the public FYERS symbol master is used when reachable)
# LOT_SIZE_NIFTY50=75
# LOT_SIZE_NIFTYNXT50=25
# LOT_SIZE_SENSEX=20
# LOT_SIZE_BANKNIFTY=35

# ---- Optional: chart-screenshot / scanned-PDF rule extraction -----------------
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
